# Client (Vite) — required for live Clerk auth in the browser
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Server (Vercel / future api/* routes with @clerk/backend)
# Not required for the metadata-slot MVP; document for production APIs.
CLERK_SECRET_KEY=sk_test_...

# Optional later: Neon / Vercel KV for character DB instead of Clerk metadata
# DATABASE_URL=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Premium Backpack (Stripe Checkout) ---
# Client
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
VITE_PREMIUM_BACKPACK_PRICE_ID=price_...
# Allow demo unlock UI when server has no secret (local / preview)
VITE_PREMIUM_CHECKOUT_DEMO=1

# Server (Vercel env for api/*)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PREMIUM_BACKPACK_PRICE_ID=price_...
# When STRIPE_SECRET_KEY is unset, demo grant is allowed if this is 1 (or non-production)
PREMIUM_CHECKOUT_DEMO=1
