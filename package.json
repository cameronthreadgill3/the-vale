{
  "name": "the-vale",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:itch": "node scripts/materialize-player-sprites.mjs && node scripts/patch-gameLoop-sprites.mjs && tsc --noEmit && vite build --config vite.itch.config.ts",
    "preview": "vite preview",
    "materialize-sprites": "node scripts/materialize-player-sprites.mjs",
    "prebuild": "node scripts/materialize-player-sprites.mjs && node scripts/patch-gameLoop-sprites.mjs",
    "predev": "node scripts/materialize-player-sprites.mjs && node scripts/patch-gameLoop-sprites.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "vite": "^8.3.0"
  }
}
